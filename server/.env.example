# Copy this file to `.env` and fill in real values before running or deploying.
# Never commit the real `.env` — it's already gitignored.

# Postgres connection string. In docker-compose this matches the `postgres`
# service's own POSTGRES_* values below — keep them in sync if you change one.
DATABASE_URL="postgresql://okrutnik:changeme@postgres:5432/okrutnik_breath?schema=public"

# Used by the postgres container itself (docker-compose.yml).
POSTGRES_USER=okrutnik
POSTGRES_PASSWORD=changeme
POSTGRES_DB=okrutnik_breath

# Long, random string used to sign auth tokens — generate with e.g.
# `openssl rand -base64 48`. Rotating it logs every device out at once.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API listens on inside its container.
PORT=8080

# Host port docker-compose publishes the API on — point Nginx Proxy
# Manager's Proxy Host target at <vps-ip>:<this port>. Change it if 8080 is
# already used by something else on the VPS.
HOST_PORT=8080

# Path to a Firebase service-account JSON (Project Settings > Service
# Accounts > Generate new private key in the Firebase console), mounted into
# the container. Only needed for the smart-notifications cron — everything
# else works without it.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# Hour (0-23, server time) the daily smart-notifications job runs.
NOTIFICATIONS_CRON_HOUR=19

# Public hostname for this API — informational here (docker-compose has no
# Traefik-style labels since the VPS uses Nginx Proxy Manager instead). Set
# this as the domain on the NPM Proxy Host you point at <vps-ip>:HOST_PORT.
DOMAIN=breath.lysyweb.pl

# Which tag of ghcr.io/lysyokrutnik/okrutnik-breath-server to pull. The
# publish workflow pushes both `latest` and `sha-<commit>` on every push to
# server/** on main — pin to a sha tag for a reproducible rollback target,
# or leave as `latest` to always run the most recent build.
IMAGE_TAG=latest

# SMTP creds for sending real email-verification / password-reset mail.
# Leave unset and mailer.ts just logs the email body to the container
# console instead of sending anything — fine for local dev, useless in
# production. For Gmail: an "app password" (not your real password), smtp.gmail.com,
# port 587. Any other transactional-email provider's SMTP creds work too.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@lysyweb.pl

# Public base URL the verification/reset email links point to.
APP_PUBLIC_URL=https://breath.lysyweb.pl

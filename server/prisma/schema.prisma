generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  profileName  String?
  createdAt    DateTime @default(now())

  /// Not required to use the API (auth works immediately on register), but
  /// surfaced to the user — an unverified account means the email address
  /// wasn't confirmed to actually belong to whoever registered it.
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?

  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  /// Bumped on "log out everywhere" and on a password change — included in
  /// every issued JWT and checked on every request, so incrementing this
  /// instantly invalidates every previously-issued token for this user
  /// (JWTs are otherwise stateless and can't be revoked individually).
  tokenVersion Int @default(0)

  /// Grants access to the separate /admin web panel — never surfaced or
  /// checked anywhere in the mobile app's own API paths.
  isAdmin Boolean @default(false)

  /// Set by an admin to ban the account. `requireAuth` rejects every mobile
  /// request for a disabled account instead of deleting any data.
  disabledAt DateTime?

  /// Set server-side at registration, never trusted from the client alone —
  /// the request must carry `acceptedTerms: true` or registration is
  /// rejected. Null for accounts created before this existed.
  termsAcceptedAt DateTime?

  sessions                Session[]
  freedivingLogs          FreedivingLog[]
  customPresets           CustomPreset[]
  customFreedivingPresets CustomFreedivingPreset[]
  profileState            ProfileState?
  challengeParticipants   ChallengeParticipant[]
  devices                 Device[]
  feedback                Feedback[]
  announcementsSent       Announcement[]
}

/// One row per registered push-notification target. Replaces a single
/// `fcmToken` column on [User] — a user with two phones logging in on the
/// second no longer silently kills push on the first.
model Device {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String   @unique
  createdAt DateTime @default(now())

  /// Short client-supplied description (e.g. "SM-A546B, Android 14") set at
  /// registration — without this, the device-management list in Settings
  /// would show nothing but dates. Optional since older rows predate it.
  label String?
}

/// Mirrors the local `Sessions` Drift table. Immutable once created except
/// for `rpeScore` (rated shortly after) — append-only from the client's
/// perspective, so merging two devices' lists is just a union by [id], never
/// a real conflict. [id] is a client-generated UUID (not an autoincrement
/// int, which would collide across devices), stable across sync round-trips.
model Session {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelKey     String
  timestamp    DateTime
  durationSec  Int
  rounds       Int
  retentionSec Int
  rpeScore     Int?
  xpEarned     Int
  updatedAt    DateTime @updatedAt

  @@index([userId, timestamp])
}

/// Mirrors the local `FreedivingSessionLog` table — same
/// append-only-except-rpeScore shape as [Session].
model FreedivingLog {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableType       String
  pbUsedSec       Int
  roundsJson      String
  roundsCompleted Int
  durationSec     Int
  timestamp       DateTime
  rpeScore        Int?

  /// Post-session symptom check-in ('tingling'/'dizziness'/'ok') — mirrors
  /// the local Drift column of the same name, added here belatedly (it
  /// existed on-device but was never wired through sync until now).
  symptomTag String?
  updatedAt  DateTime @updatedAt

  @@index([userId, timestamp])
}

/// User-authored breathing pattern presets. Real CRUD (not append-only) —
/// last-write-wins by [updatedAt]. Soft-deleted so a deletion on one device
/// propagates to others instead of a re-appearing "zombie" preset.
model CustomPreset {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  inhaleSec  Int
  holdInSec  Int
  exhaleSec  Int
  holdOutSec Int
  cycles     Int
  rounds     Int
  createdAt  DateTime
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

/// User-authored freediving table presets — same shape as [CustomPreset].
model CustomFreedivingPreset {
  id            String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  startApneaSec Int
  endApneaSec   Int
  startRestSec  Int
  endRestSec    Int
  rounds        Int
  createdAt     DateTime
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

/// One row per user — the "singleton" state that isn't derivable purely from
/// session history (PB verification, safety consent, the Wim Hof ladder's
/// confirmed level, and weekly-plan preferences). Resolved last-write-wins
/// by [updatedAt] on sync, in contrast to XP/level/streak, which the client
/// recomputes locally from the merged session history instead of syncing.
model ProfileState {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedPbSec           Int?
  verifiedPbAt            DateTime?
  verifiedPbCo2Sec        Int?
  verifiedPbCo2At         DateTime?
  safetyAcknowledgedAt    DateTime?
  wimHofCurrentLevelKey   String?
  wimHofCurrentLevelSetAt DateTime?
  availableWeekdaysMask   Int?
  availableHourStart      Int?
  availableHourEnd        Int?
  allowMultiplePerDay     Boolean?
  dailyReminderEnabled    Boolean?

  /// Set by the client to the local wall-clock time the underlying settings
  /// actually changed — the basis for last-write-wins, since Prisma's own
  /// `updatedAt` only reflects when the *row* was last written on the
  /// server, not when the source device's data changed. A push with an
  /// older `clientUpdatedAt` than what's already stored is ignored.
  clientUpdatedAt DateTime
  updatedAt       DateTime @updatedAt
}

enum ChallengeMetric {
  STREAK
  TOTAL_RETENTION_SEC
  SESSION_COUNT
}

/// Backend-defined (seeded, not user-created) time-boxed challenges. The
/// leaderboard is never stored — it's computed on read from participants'
/// synced session data within [startsAt, endsAt], so it can never drift out
/// of sync with the underlying sessions.
model Challenge {
  id          String          @id @default(uuid())
  key         String          @unique
  title       String
  description String
  metric      ChallengeMetric
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime        @default(now())

  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([challengeId, userId])
}

/// A bug report / opinion submitted from the app's Settings screen. Reviewed
/// and resolved from the /admin panel — there is no other inbox for this.
model Feedback {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String?
  message    String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([createdAt])
}

/// History of admin-triggered push broadcasts (sent via the same FCM path
/// as the daily notifications cron) — exists purely so the /admin panel can
/// show what was announced and when, not for retry/delivery tracking.
model Announcement {
  id         String   @id @default(uuid())
  title      String
  body       String
  sentAt     DateTime @default(now())
  sentById   String
  sentBy     User     @relation(fields: [sentById], references: [id], onDelete: Cascade)
}
